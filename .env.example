# Copy this file to .env and fill in real values before running the app.

# --- Database (MySQL/TiDB) ---
DATABASE_URL=mysql://user:password@host:3306/coachforge

# --- Session cookie signing ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=

# --- Google OAuth ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <your-app-origin>/api/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as GOOGLE_CLIENT_ID, exposed to the client bundle (Vite only
# exposes VITE_-prefixed vars). OAuth client IDs are not secret.
VITE_GOOGLE_CLIENT_ID=

# --- Supabase Storage (file uploads) ---
# Project URL and service_role key from https://app.supabase.com/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket to upload into (create it in the Supabase dashboard first).
SUPABASE_STORAGE_BUCKET=coachforge-uploads

# --- Admin bootstrap ---
# The Google "sub" (unique ID) of the account that should get the admin/trainer
# role on first login. Sign in once, check the users table for your openId,
# then set this and re-deploy (or update the row directly).
OWNER_OPEN_ID=

PORT=3000
